# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/zoho_clone"

# Redis
REDIS_URL="redis://localhost:6379"

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-32-char-string"

# Email (dev — points to MailHog)
SMTP_HOST="localhost"
SMTP_PORT="1025"
SMTP_FROM="noreply@zoho-clone.dev"

# File storage (dev)
STORAGE_DRIVER="local"
STORAGE_LOCAL_PATH="./uploads"

# S3-compatible (prod)
# STORAGE_DRIVER="s3"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
# S3_ENDPOINT=""

# Currency rates (optional)
