{
  "name": "zoho-clone",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.1.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "playwright test",
    "db:migrate": "turbo run db:migrate --filter=@zoho-clone/db",
    "db:seed": "turbo run db:seed --filter=@zoho-clone/db",
    "db:studio": "pnpm --filter=@zoho-clone/db exec prisma studio",
    "db:generate": "pnpm --filter=@zoho-clone/db exec prisma generate",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.1.3",
    "typescript": "^5.4.5",
    "@types/node": "^20.14.0",
    "prettier": "^3.3.2",
    "eslint": "^8.57.0"
  },
  "engines": {
    "node": ">=20",
    "pnpm": ">=9"
  }
}
